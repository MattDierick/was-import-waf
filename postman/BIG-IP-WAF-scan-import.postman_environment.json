{
  "id": "bigip-waf-scan-import",
  "name": "BIG-IP WAF scan import",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "bigip_host",
      "value": "192.0.2.10",
      "type": "default",
      "enabled": true,
      "description": "BIG-IP management address (add :port if not 443)"
    },
    {
      "key": "bigip_username",
      "value": "admin",
      "type": "default",
      "enabled": true
    },
    {
      "key": "bigip_password",
      "value": "",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "scan_filename",
      "value": "vulnerabilities.xml",
      "type": "default",
      "enabled": true
    },
    {
      "key": "policy_name",
      "value": "arcadia_policy",
      "type": "default",
      "enabled": true,
      "description": "name, full path or id"
    },
    {
      "key": "domain_names",
      "value": "arcadia-mybank.emea.f5se.com",
      "type": "default",
      "enabled": true,
      "description": "comma separated"
    },
    {
      "key": "import_all_domains",
      "value": "false",
      "type": "default",
      "enabled": true
    },
    {
      "key": "vulnerability_ids",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "blank = all resolvable open ones; or comma separated ids"
    }
  ]
}